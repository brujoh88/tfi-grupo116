// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

model Salon {
  id     Int    @id @default(autoincrement())
  nombre String

  servicios Servicio[]
  extras    Extra[]
  retiros   Retiro[]
  lugares   Lugar[]
  clientas  Clienta[]
}

model Servicio {
  id              Int     @id @default(autoincrement())
  nombre          String
  precio          Int
  duracionMinutos Int
  activo          Boolean @default(true)

  salonId Int
  salon   Salon @relation(fields: [salonId], references: [id])

  extras   ServicioExtra[]
  lugares  LugarServicio[]
  reservas Reserva[]

  @@unique([salonId, nombre])
}

model Extra {
  id              Int     @id @default(autoincrement())
  nombre          String
  precio          Int
  duracionMinutos Int
  activo          Boolean @default(true)

  salonId Int
  salon   Salon @relation(fields: [salonId], references: [id])

  servicios ServicioExtra[]
  reservas  ReservaExtra[]

  @@unique([salonId, nombre])
}

model Retiro {
  id              Int     @id @default(autoincrement())
  nombre          String
  precio          Int
  duracionMinutos Int
  activo          Boolean @default(true)

  salonId Int
  salon   Salon @relation(fields: [salonId], references: [id])

  reservas Reserva[]

  @@unique([salonId, nombre])
}

// Qué extra se puede sumar a qué servicio. Una fila por combinación permitida.
model ServicioExtra {
  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  extraId Int
  extra   Extra @relation(fields: [extraId], references: [id])

  @@id([servicioId, extraId])
}

// ---------------------------------------------------------------------------
// Grilla
// ---------------------------------------------------------------------------

// El lugar físico donde se atiende: una mesa de uñas, una camilla. Es lo que
// limita cuántos turnos entran a la vez; su horario lleva implícito el de quien
// lo atiende.
model Lugar {
  id     Int     @id @default(autoincrement())
  nombre String
  activo Boolean @default(true)

  salonId Int
  salon   Salon @relation(fields: [salonId], references: [id])

  servicios   LugarServicio[]
  franjas     Franja[]
  excepciones Excepcion[]
  reservas    Reserva[]

  @@unique([salonId, nombre])
}

// Qué servicio se puede hacer en qué lugar. Una fila por combinación permitida.
model LugarServicio {
  lugarId Int
  lugar   Lugar @relation(fields: [lugarId], references: [id])

  servicioId Int
  servicio   Servicio @relation(fields: [servicioId], references: [id])

  @@id([lugarId, servicioId])
}

// La plantilla semanal: cuándo está abierto cada lugar. Un lugar puede tener
// varias franjas el mismo día (de 9 a 13 y de 15 a 19).
// Las horas van en minutos desde la medianoche (9:30 es 570) y el día de la
// semana de 0 (domingo) a 6 (sábado), como lo cuentan Postgres y JavaScript.
// ⚠️ Que el día esté entre 0 y 6 y que desde < hasta lo controla la base con
// CHECK escritos a mano en la migración 20260924162428_grilla: acá no se ven.
model Franja {
  id          Int @id @default(autoincrement())
  diaSemana   Int
  desdeMinuto Int
  hastaMinuto Int

  lugarId Int
  lugar   Lugar @relation(fields: [lugarId], references: [id])
}

enum TipoExcepcion {
  ABRE
  CIERRA
}

// Lo que la dueña cambia un día puntual: abre una franja que la plantilla no
// tiene, o cierra una que sí. La fecha es un día suelto, sin hora ni zona
// horaria: el 14/10 es el 14/10 aunque el servidor corra en otro huso.
// ⚠️ Que desde < hasta lo controla un CHECK de la migración 20260924162428_grilla.
model Excepcion {
  id          Int           @id @default(autoincrement())
  fecha       DateTime      @db.Date
  desdeMinuto Int
  hastaMinuto Int
  tipo        TipoExcepcion

  lugarId Int
  lugar   Lugar @relation(fields: [lugarId], references: [id])
}

// ---------------------------------------------------------------------------
// Reservas
// ---------------------------------------------------------------------------

// Quien reserva. Se identifica por teléfono, sin registro. Guarda lo mismo que
// se guardaría en cada reserva, escrito una sola vez: no es una ficha ni un
// historial, que están fuera del MVP.
model Clienta {
  id       Int    @id @default(autoincrement())
  telefono String
  nombre   String

  salonId Int
  salon   Salon @relation(fields: [salonId], references: [id])

  reservas Reserva[]

  @@unique([salonId, telefono])
}

// Un turno tomado: quién, dónde, qué día y de qué hora a qué hora, con lo que
// armó y el precio de cada cosa copiado al momento de reservar. Si el catálogo
// cambia después, la reserva sigue diciendo lo que se cobró.
// Las horas van como en la grilla: minutos desde la medianoche. La duración no
// se guarda aparte porque es fin menos inicio.
// ⚠️ Que dos reservas de la misma mesa y el mismo día no se superpongan lo
// garantiza una restricción EXCLUDE escrita a mano en la migración: acá no se ve.
model Reserva {
  id           Int      @id @default(autoincrement())
  fecha        DateTime @db.Date
  inicioMinuto Int
  finMinuto    Int
  creadaEn     DateTime @default(now())

  clientaId Int
  clienta   Clienta @relation(fields: [clientaId], references: [id])

  lugarId Int
  lugar   Lugar @relation(fields: [lugarId], references: [id])

  servicioId     Int
  servicio       Servicio @relation(fields: [servicioId], references: [id])
  servicioPrecio Int

  retiroId     Int?
  retiro       Retiro? @relation(fields: [retiroId], references: [id], onDelete: Restrict)
  retiroPrecio Int?

  extras ReservaExtra[]
}

// Los extras de una reserva, con el precio de cada uno al momento de reservar.
model ReservaExtra {
  reservaId Int
  reserva   Reserva @relation(fields: [reservaId], references: [id])

  extraId Int
  extra   Extra @relation(fields: [extraId], references: [id])

  precio Int

  @@id([reservaId, extraId])
}
