# Copiar a .env y completar. El .env real no se commitea.
# Desarrollo: la base del docker-compose.yml de la raíz (puerto 5433 del host).
DATABASE_URL="postgresql://turnos:turnos@localhost:5433/turnos?schema=public"

# A qué salón sirve esta API. Hoy es uno solo y lo fija el despliegue; el día que
# haya varios, el id sale del pedido y esta variable desaparece.
SALON_ID="1"

# Desde qué páginas el navegador puede usar esta API (CORS), separadas por coma.
# Desarrollo: el front de Vite. En producción va la URL de Vercel. Vacía, el
# navegador no deja que ninguna página la use.
CORS_ORIGENES="http://localhost:5173"
